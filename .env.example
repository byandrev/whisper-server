# Dominio que apunta a esta máquina (Caddy saca el certificado solo).
# Para probar en local sin HTTPS, o detrás de Dokploy/Traefik: DOMAIN=:80
DOMAIN=

# Secreto compartido
# Genera uno con: openssl rand -hex 32
WHISPER_SECRET=

# large-v3-turbo-q5_0 (≈550 MB, buena calidad) · small (≈470 MB) · base (≈140 MB, rápido, peor español)
WHISPER_MODEL=large-v3-turbo-q5_0
WHISPER_LANG=es
# Núcleos de la máquina.
WHISPER_THREADS=4
